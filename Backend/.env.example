# Copy this file to `.env` and fill in your own values.

# PostgreSQL connection string (requires PostgreSQL >= 15).
# Hosted databases usually need SSL, e.g. add ?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Redis (cache). Local: redis://localhost:6379. Upstash: rediss://default:<password>@<host>:6379
REDIS_URL="redis://localhost:6379"

# Port for the API (hosting platforms set this automatically)
PORT=3000

# Frontend origin(s) allowed by CORS, comma separated. Leave empty locally to allow any origin.
# Example: CLIENT_URL="https://your-app.vercel.app"
CLIENT_URL=
